---
// Base layout — every page wraps in this. Header, nav, footer, and all styles live here.
const { title = 'Shyam Prasad Rao', description = 'Hard problems — technical, commercial, and otherwise.' } = Astro.props;
const path = Astro.url.pathname;
const isActive = (href) => (href === '/' ? path === '/' : path.startsWith(href));
const nav = [
  { href: '/', label: 'Home' },
  { href: '/writing', label: 'Writing' },
  { href: '/projects', label: 'Projects' },
  { href: '/atlas', label: 'Atlas' },
  { href: '/about', label: 'About' },
];
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body>
  <div class="wrap">
    <header>
      <div class="masthead">
        <a href="/" class="name">Shyam Prasad Rao</a>
      </div>
      <div class="tagline">Hard problems — technical, commercial, and otherwise.</div>
      <nav>
        {nav.map((n) => (
          <a href={n.href} class={isActive(n.href) ? 'active' : ''}>{n.label}</a>
        ))}
        <a href="https://github.com/shyam-lab" target="_blank" rel="noopener">GitHub&#8599;</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <span>&copy; 2026 Shyam Prasad Rao</span>
      <span>
        <a href="mailto:shyamprasadrao@gmail.com">Email</a> &middot;
        <a href="https://github.com/shyam-lab" target="_blank" rel="noopener">GitHub</a>
      </span>
    </footer>
  </div>
</body>
</html>

<style is:global>
  :root{
    --paper:#F7F5F0; --ink:#1C1B18; --ink-soft:#4A4842; --faint:#8B887E;
    --rule:#DAD6CB; --accent:#2F4B4B; --accent-soft:#6E8B87; --mark:#B4552E;
    --maxw:720px;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{
    background:var(--paper);color:var(--ink);
    font-family:"Iowan Old Style","Palatino Linotype",Palatino,Georgia,serif;
    line-height:1.6;-webkit-font-smoothing:antialiased;
  }
  .wrap{max-width:var(--maxw);margin:0 auto;padding:0 24px}

  header{padding:48px 0 0}
  .masthead{display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:8px}
  .name{font-size:26px;font-weight:600;letter-spacing:-.01em;text-decoration:none;color:var(--ink)}
  .tagline{font-family:ui-monospace,"SF Mono",Menlo,monospace;font-size:12.5px;letter-spacing:.02em;color:var(--faint);margin-top:4px}
  nav{margin-top:26px;padding-bottom:14px;border-bottom:1px solid var(--rule);display:flex;gap:22px;flex-wrap:wrap;font-family:ui-monospace,"SF Mono",Menlo,monospace;font-size:13px;letter-spacing:.03em}
  nav a{text-decoration:none;color:var(--ink-soft);padding-bottom:2px;border-bottom:1.5px solid transparent}
  nav a:hover{color:var(--ink);border-color:var(--accent)}
  nav a.active{color:var(--accent);border-color:var(--accent)}

  main{padding:40px 0 80px;min-height:50vh}

  .lede{font-size:19px;line-height:1.55;color:var(--ink-soft);max-width:56ch}
  .lede strong{color:var(--ink);font-weight:600}

  h2.sec{font-family:ui-monospace,"SF Mono",Menlo,monospace;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--faint);font-weight:600;margin:44px 0 16px;display:flex;align-items:center;gap:10px}
  h2.sec::before{content:"";width:14px;height:1px;background:var(--mark)}

  .item{display:block;text-decoration:none;color:inherit;padding:16px 0;border-bottom:1px solid var(--rule)}
  .item:hover .it-title{color:var(--accent)}
  .it-title{font-size:19px;font-weight:600;letter-spacing:-.01em;transition:color .15s}
  .it-meta{font-family:ui-monospace,"SF Mono",Menlo,monospace;font-size:11.5px;color:var(--faint);letter-spacing:.02em;margin-top:5px;display:flex;gap:10px;flex-wrap:wrap;align-items:center}
  .tag{color:var(--accent-soft)}
  .it-desc{font-size:15px;color:var(--ink-soft);margin-top:7px;max-width:60ch}
  .empty{font-size:14px;color:var(--faint);font-style:italic;padding:14px 0;border-bottom:1px solid var(--rule)}

  .lately{font-family:ui-monospace,"SF Mono",Menlo,monospace;font-size:13px;color:var(--ink-soft);border-left:2px solid var(--mark);padding:2px 0 2px 14px;margin:22px 0}
  .lately b{color:var(--ink)}

  /* Atlas section — concept-map plates */
  .crumbs{font-family:ui-monospace,"SF Mono",Menlo,monospace;font-size:12px;color:var(--faint);letter-spacing:.02em;margin-bottom:18px}
  .crumbs a{color:var(--accent-soft);text-decoration:none}
  .crumbs a:hover{color:var(--accent)}
  .crumbs .sep{margin:0 6px;opacity:.6}

  .legend{font-family:ui-monospace,"SF Mono",Menlo,monospace;font-size:12px;color:var(--faint);display:flex;gap:18px;flex-wrap:wrap;margin-top:20px}
  .dotk{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:6px;vertical-align:0}
  .dotk.done{background:var(--accent)}
  .dotk.wip{background:var(--mark)}
  .dotk.soon{background:transparent;border:1.5px dashed var(--faint)}

  h1.page{font-size:30px;letter-spacing:-.02em;margin:6px 0 4px;line-height:1.2}

  .plate{margin:34px 0 8px}
  @media(min-width:1000px){.plate{margin-left:-110px;margin-right:-110px}}
  .plate-caption{font-family:ui-monospace,"SF Mono",Menlo,monospace;font-size:11.5px;color:var(--faint);letter-spacing:.02em;text-align:center;margin-top:6px}
  svg text{font-family:ui-monospace,"SF Mono",Menlo,monospace;fill:var(--ink)}

  .edge2{stroke:#A9A395;stroke-width:1.1;fill:none}
  .edge2.rel{stroke-dasharray:5 4}
  .edge2.lead{stroke-dasharray:1.5 3}
  .elabel{font-family:ui-monospace,"SF Mono",Menlo,monospace;font-size:9.5px;font-style:italic;fill:var(--faint)}
  .elabel-bg{fill:var(--paper);opacity:.85}

  .b{fill:#FCFBF5;stroke-width:1.2}
  .b.done{stroke:var(--accent)}
  .b.wip{stroke:var(--mark)}
  .b.soon{stroke:var(--faint);stroke-dasharray:4 3}
  .btitle{font-family:"Iowan Old Style","Palatino Linotype",Palatino,Georgia,serif;font-size:13.5px;font-weight:700;fill:var(--ink)}
  .soon .btitle, g.soonbox .btitle{fill:var(--faint)}
  .bitem{font-family:"Iowan Old Style","Palatino Linotype",Palatino,Georgia,serif;font-size:11.5px;fill:var(--ink-soft)}
  g.soonbox .bitem{fill:var(--faint)}
  .bitem.link{fill:var(--accent);font-weight:600}
  .bitem.link:hover{text-decoration:underline}
  .cbox rect{fill:var(--ink);stroke:var(--ink)}
  .cbox text{font-family:ui-monospace,"SF Mono",Menlo,monospace;font-size:13px;font-weight:600;letter-spacing:.14em;fill:var(--paper)}
  .maplegend text{font-family:ui-monospace,"SF Mono",Menlo,monospace;font-size:10px;fill:var(--faint)}
  .clickbox{cursor:pointer}
  .clickbox:hover rect.b{fill:#F3F0E7}

  footer{border-top:1px solid var(--rule);padding:26px 0 60px;font-family:ui-monospace,"SF Mono",Menlo,monospace;font-size:12px;color:var(--faint);display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px}
  footer a{color:var(--accent-soft);text-decoration:none}
  footer a:hover{color:var(--accent)}

  /* article body */
  .post h1{font-size:30px;letter-spacing:-.02em;margin:6px 0 4px;line-height:1.2}
  .post .it-meta{margin-bottom:26px}
  .post p{font-size:17px;color:var(--ink-soft);margin:0 0 18px;max-width:62ch}
  .post h2{font-size:21px;margin:32px 0 12px;color:var(--ink);letter-spacing:-.01em}
  .post h3{font-size:17px;margin:24px 0 8px;color:var(--ink)}
  .post a{color:var(--accent);text-underline-offset:2px}
  .post ul,.post ol{margin:0 0 18px 22px;color:var(--ink-soft);font-size:17px}
  .post li{margin-bottom:6px}
  .post strong{color:var(--ink)}
  .post table{border-collapse:collapse;margin:18px 0;font-size:15px;width:100%}
  .post th,.post td{border:1px solid var(--rule);padding:8px 10px;text-align:left;vertical-align:top;color:var(--ink-soft)}
  .post th{background:#EDEAE1;color:var(--ink);font-weight:600}
  .post blockquote{border-left:2px solid var(--mark);padding-left:14px;color:var(--faint);font-style:italic;margin:0 0 18px}
  .post h2 .qnum{font-family:ui-monospace,"SF Mono",Menlo,monospace;font-size:11px;color:var(--mark);letter-spacing:.1em;vertical-align:3px;margin-right:8px}
  .back{font-family:ui-monospace,"SF Mono",Menlo,monospace;font-size:12px;color:var(--accent-soft);text-decoration:none}
  .back:hover{color:var(--accent)}

  /* evergreen-note signature patterns */
  .formula{font-family:ui-monospace,"SF Mono",Menlo,monospace;background:#EDEAE1;border:1px solid var(--rule);padding:12px 16px;margin:0 0 18px;font-size:14px;overflow-x:auto;color:var(--ink);line-height:1.9}
  .formula .dim{color:var(--faint)}

  .pill{font-family:ui-monospace,"SF Mono",Menlo,monospace;font-size:11.5px;letter-spacing:.02em}
  .pill.pub{color:var(--accent)}

  .reading{margin:0 0 18px}
  .reading li{list-style:none;padding:10px 0;border-bottom:1px solid var(--rule);font-size:15.5px;color:var(--ink-soft);margin:0}
  .reading .src{font-family:ui-monospace,"SF Mono",Menlo,monospace;font-size:11px;color:var(--faint);margin-left:8px}

  .connected{border-top:1px solid var(--rule);margin-top:36px;padding-top:6px}
  .next-links{display:flex;flex-direction:column}
  .next-links .nl{font-size:15.5px;color:var(--ink);padding:8px 0;border-bottom:1px solid var(--rule)}
  .next-links a.nl{color:var(--accent);text-decoration:none;cursor:pointer}
  .next-links a.nl:hover{text-underline-offset:2px;text-decoration:underline}
  .next-links .st{font-family:ui-monospace,"SF Mono",Menlo,monospace;font-size:11px;color:var(--faint);margin-left:8px}

  /* Bloch sphere figure */
  .bloch{display:block;margin:0 auto;max-width:400px}
  .bloch .ax{stroke:var(--rule);stroke-width:1.2}
  .bloch .sphere{fill:none;stroke:#A9A395;stroke-width:1.2}
  .bloch .equator{fill:none;stroke:#A9A395;stroke-width:1;stroke-dasharray:4 3}
  .bloch .statev{stroke:var(--accent);stroke-width:2}
  .bloch .proj{stroke:var(--accent-soft);stroke-width:1;stroke-dasharray:3 3}
  .bloch .angw{fill:var(--mark);fill-opacity:.13;stroke:var(--mark);stroke-width:1.1;stroke-linejoin:round}
  .bloch text{font-size:12px}
  .bloch text.dim{fill:var(--faint);font-size:10.5px}
  .bloch text.ang-l{fill:var(--mark);font-style:italic;font-size:12px}

  @media(max-width:520px){
    .it-title,.lede{font-size:17px}
    header{padding-top:32px}
    .post h1,h1.page{font-size:25px}
  }
</style>
