---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d) => d.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
---
<Base title={`${post.data.title} — Shyam Prasad Rao`} description={post.data.summary}>
  <article class="post">
    <a class="back" href="/writing">&larr; Writing</a>
    <h1>{post.data.title}</h1>
    <div class="it-meta"><span>{fmt(post.data.date)}</span><span class="tag">{post.data.topic}</span></div>
    <Content />
  </article>
</Base>
